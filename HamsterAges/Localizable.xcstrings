    "Stages, seeds, upgrades and generals will be lost. Purchases can be restored." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Етапи, насіння, покращення й генерали буде втрачено. Покупки можна відновити."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stufen, Samen, Verbesserungen und Generäle gehen verloren. Käufe können wiederhergestellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se perderán las fases, semillas, mejoras y generales. Las compras se pueden restaurar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niveaux, graines, améliorations et généraux seront perdus. Les achats peuvent être restaurés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livelli, semi, potenziamenti e generali andranno persi. Gli acquisti si possono ripristinare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fases, sementes, melhorias e generais serão perdidos. As compras podem ser restauradas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステージ、種、強化、将軍は失われます。購入は復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단계, 씨앗, 강화, 장군이 사라져요. 구매는 복원할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关卡、种子、升级和将军都将丢失。购买项目可以恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關卡、種子、升級和將軍都將遺失。購買項目可以恢復。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölümler, tohumlar, geliştirmeler ve generaller silinecek. Satın alımlar geri yüklenebilir."
          }
        }
      }
    },

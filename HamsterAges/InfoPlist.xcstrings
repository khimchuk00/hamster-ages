{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSUserTrackingUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your data is used to show ads that are more relevant to you and keep Hamster Ages free."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані використовуються, щоб показувати релевантнішу рекламу і зберегти Hamster Ages безкоштовною."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten werden genutzt, um passendere Werbung zu zeigen und Hamster Ages kostenlos zu halten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos se usan para mostrar anuncios más relevantes y mantener Hamster Ages gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes données servent à afficher des pubs plus pertinentes et à garder Hamster Ages gratuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati servono a mostrare annunci più pertinenti e a mantenere Hamster Ages gratuito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados são usados para mostrar anúncios mais relevantes e manter Hamster Ages grátis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データはより関連性の高い広告を表示し、Hamster Agesを無料で提供するために使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 더 관련성 높은 광고를 보여 주고 Hamster Ages를 무료로 유지하는 데 사용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的数据将用于展示更相关的广告，让 Hamster Ages 保持免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的資料將用於顯示更相關的廣告，讓 Hamster Ages 保持免費。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilerin daha alakalı reklamlar göstermek ve Hamster Ages'i ücretsiz tutmak için kullanılır."
          }
        }
      }
    },
